<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_delivery_auth">
            <field name="name">Control de Entregas</field>
            <field name="description">Gestión de autorizaciones para entregas no pagadas.</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_delivery_auth" model="res.groups.privilege">
            <field name="name">Aprobación de Entregas</field>
            <field name="category_id" ref="module_category_delivery_auth"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_delivery_approver" model="res.groups">
            <field name="name">Gerente de Aprobación de Entregas</field>
            <field name="privilege_id" ref="privilege_delivery_auth"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Miembros que reciben ACTIVIDADES automáticas de logística:
             al aprobarse una autorización de entrega y al registrarse un
             pago de una orden. Solo define destinatarios; no da permisos. -->
        <record id="group_delivery_logistics" model="res.groups">
            <field name="name">Logística — Avisos</field>
            <field name="privilege_id" ref="privilege_delivery_auth"/>
            <field name="comment">Usuarios que reciben actividades automáticas
                cuando se autoriza la entrega de material y cuando se registra
                un pago (para programar/preparar la entrega).</field>
        </record>
    </data>
</odoo>